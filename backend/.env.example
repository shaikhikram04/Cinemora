PORT=3000

# Number of reverse proxies in front of this process, for req.ip / rate
# limiting. 1 on Render/Railway/Fly/Heroku or behind a single nginx; 0 when
# binding directly to the internet. Getting it wrong either buckets every user
# into one rate-limit counter (too low) or lets clients forge their own IP via
# X-Forwarded-For (too high). Defaults to 1.
TRUST_PROXY_HOPS=1

# Comma-separated browser origins allowed to call the API. Leave empty for the
# mobile app — native clients send no Origin and CORS does not apply to them.
CORS_ORIGINS=

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/watchary

# JWT secrets
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# TMDB API key (from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Firebase service account (paste the full JSON as a single-line string)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Cloudinary — stores profile avatars and cover images.
# Copy verbatim from Cloudinary dashboard → Account Details → API environment variable.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Python recommender service (internal, not publicly exposed)
RECOMMENDER_URL=http://localhost:8000
# Must match INTERNAL_SERVICE_SECRET in recommender/.env. Both services refuse
# to start unless this is set to a real value of 16+ characters — the
# recommender's /internal/* routes trust the X-User-Id header outright, so this
# secret is the only thing separating them from the internet.
#   openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

# Shared with the recommender service; cache is optional (fails open if down)
REDIS_URL=redis://localhost:6379/0
