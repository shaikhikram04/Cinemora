<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext is a DEBUG-ONLY affordance, so the local backend can be
         reached over plain http (adb reverse to localhost:3000, an emulator on
         10.0.2.2, or the laptop's LAN IP). It lives here rather than in the
         main manifest on purpose: release builds must not carry it, or an
         http:// baseUrl would ship silently and every user's JWT would cross
         the network in the clear. -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
